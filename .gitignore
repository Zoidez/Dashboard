# Instance state: never committed, never touched by builds
Build/data/
Build/ClaudeExchange/reports/**/*.json
Build/ClaudeExchange/staging/
Build/app/
node_modules/
dist/
spikes/results-*.txt

# Spike working files: downloads, npm cache, Process Monitor captures (large; raw output may contain the account e-mail)
spikes/_tmp/
spikes/results/*/raw/

# Project-local toolchain (portable Node 24, verified download)
tools/node/
tools/_dl/
tools/_x/

# Test output
test-results/
playwright-report/

# Packaging output (the portable app is copied into Build/app/)
pack/
pack-resources/
Build/Dashboard.lnk

# Credentials and keys: never commit (container plans: NATS credentials, per-card
# certificates, the development container's GitHub token). Added 2026-10-16.
*.creds
*.nk
*.pem
*.key
*.p12
*.pfx
.env
.env.*
infra/**/secrets/
