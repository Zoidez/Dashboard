{
  "name": "dashboard",
  "version": "0.0.1",
  "private": true,
  "description": "Portable Windows dashboard of sandboxed cards",
  "main": "dist/main/index.js",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "npm run build && electron . --instance=Build",
    "test:unit": "node --import tsx --test \"test/unit/**/*.test.ts\"",
    "test:e2e": "npm run build && playwright test -c test/e2e/playwright.config.ts",
    "test": "npm run typecheck && npm run test:unit && npm run test:e2e",
    "test:race": "node --import tsx --test test/race/*.test.ts",
    "test:host-suite": "node scripts/record-host-suite.mjs --instance=Build"
  },
  "dependencies": {
    "ajv": "8.20.0",
    "koffi": "3.3.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "typescript": "5.9.3"
  },
  "devDependencies": {
    "@playwright/test": "1.64.0",
    "@types/node": "24.19.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "electron": "44.7.0",
    "esbuild": "0.28.2",
    "tsx": "4.23.15"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "koffi@3.3.2": true
  }
}
