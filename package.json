{
  "name": "dashboard",
  "version": "0.0.1",
  "private": true,
  "description": "Portable Windows dashboard of sandboxed cards",
  "main": "dist/main/index.js",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "npm run build && electron . --instance=Build",
    "test:unit": "node scripts/run-tests.mjs test/unit",
    "test:e2e": "npm run build && playwright test -c test/e2e/playwright.config.ts",
    "test": "npm run typecheck && npm run test:unit && npm run test:e2e",
    "test:race": "node scripts/run-tests.mjs test/race",
    "test:podman": "node scripts/run-tests.mjs test/podman --test-concurrency=1",
    "test:host-suite": "node scripts/record-host-suite.mjs --instance=Build",
    "package": "node scripts/package.mjs --instance=Build",
    "setup:shortcut": "powershell -ExecutionPolicy Bypass -File scripts/make-shortcut.ps1"
  },
  "dependencies": {
    "koffi": "3.3.2",
    "typescript": "5.9.3"
  },
  "devDependencies": {
    "@fontsource/ibm-plex-sans": "5.3.0",
    "@fontsource/inter": "5.3.0",
    "@fontsource/source-sans-3": "5.3.1",
    "@playwright/test": "1.64.0",
    "@types/node": "24.19.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "ajv": "8.20.0",
    "electron": "44.7.0",
    "electron-builder": "26.15.3",
    "esbuild": "0.28.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tsx": "4.23.15"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "koffi@3.3.2": true,
    "electron-winstaller": false
  },
  "productName": "Dashboard"
}
